{
  "crons": [
    {
      "path": "/api/cron/send-daily-sheet",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/whatsapp/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|api$|whatsapp/).*)",
      "destination": "/index.html"
    }
  ]
}
